{
  "name": "mhujer/fio-api-php",
  "type": "library",
  "description": "Fio API PHP implemention",
  "keywords": [
    "fio",
    "banking",
    "api"
  ],
  "homepage": "https://github.com/mhujer/fio-api-php",
  "license": "MIT",
  "authors": [
    {
      "name": "Martin Hujer",
      "email": "mhujer@gmail.com",
      "homepage": "https://www.martinhujer.cz/",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7.15.2 || ^8.0.1",
    "composer/ca-bundle": "^1.5"
  },
  "require-dev": {
    "phpunit/phpunit": "11.5.57",
    "squizlabs/php_codesniffer": "4.0.4",
    "phpstan/phpstan": "2.3.5",
    "phpstan/phpstan-phpunit": "2.1.1",
    "phpstan/phpstan-strict-rules": "2.1.1"
  },
  "autoload": {
    "psr-4": {
      "FioApi\\": "src/FioApi"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FioApi\\": "tests/FioApi"
    }
  },
  "scripts": {
    "ci": [
      "@phpstan",
      "@phpcs",
      "@test"
    ],
    "test": "phpunit",
    "phpcs": "phpcs --standard=PSR2 src && phpcs --standard=PSR2 tests",
    "phpstan": "phpstan analyse -c phpstan.neon"
  }
}
